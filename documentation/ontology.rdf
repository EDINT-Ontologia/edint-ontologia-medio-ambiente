    <owl:Ontology rdf:about="http://qudt.org/2.1/schema/qudt">
        <owl:imports rdf:resource="http://qudt.org/2.1/schema/qudt"/>
        <owl:imports rdf:resource="http://www.opengis.net/ont/geosparql#"/>
        <owl:imports rdf:resource="http://www.w3.org/ns/sosa/"/>
        <terms:abstract xml:lang="en">A lightweight ontology extending SOSA to represent environmental measuring stations and sensors, restricting their observations to the EDINT SKOS controlled vocabulary.</terms:abstract>
        <terms:abstract xml:lang="es">Una ontología ligera que extiende SOSA para representar estaciones de medición y sensores medioambientales, restringiendo sus mediciones al vocabulario controlado SKOS de EDINT.</terms:abstract>
        <terms:bibliographicCitation xml:lang="en">EDINT Environmental Sensors Ontology. EDINT. Revision: v0.2.1.</terms:bibliographicCitation>
        <terms:bibliographicCitation xml:lang="es">Ontología EDINT de Sensores Medioambientales. EDINT. Revisión: v0.2.1.</terms:bibliographicCitation>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-18</terms:created>
        <terms:creator rdf:nodeID="genid1"/>
        <terms:creator rdf:nodeID="genid2"/>
        <terms:creator rdf:nodeID="genid3"/>
        <terms:creator rdf:nodeID="genid4"/>
        <terms:creator rdf:nodeID="genid5"/>
        <terms:description xml:lang="en">A lightweight ontology extending SOSA to represent environmental measuring stations and sensors, restricting their observations to the EDINT SKOS controlled vocabulary.</terms:description>
        <terms:description xml:lang="es">Una ontología ligera que extiende SOSA para representar estaciones de medición y sensores medioambientales, restringiendo sus mediciones al vocabulario controlado SKOS de EDINT.</terms:description>
        <terms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-09-17</terms:issued>
        <terms:license rdf:resource="https://creativecommons.org/licenses/by/4.0/"/>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-09-17</terms:modified>
        <terms:publisher rdf:nodeID="genid6"/>
        <terms:title xml:lang="en">EDINT Environmental Sensors Ontology</terms:title>
        <terms:title xml:lang="es">Ontología EDINT de Sensores Medioambientales</terms:title>
        <vann:preferredNamespacePrefix>edintmed</vann:preferredNamespacePrefix>
        <vann:preferredNamespaceUri rdf:resource="https://edint.es/def/medio-ambiente#"/>
        <rdfs:label xml:lang="en">Environmental Sensors</rdfs:label>
        <rdfs:label xml:lang="es">Sensores Medioambientales</rdfs:label>
        <owl:priorVersion rdf:resource="https://github.com/EDINT-Ontologia/edint-ontologia-medio-ambiente/releases/tag/v0.2.0"/>
        <owl:versionInfo>0.2.1</owl:versionInfo>
